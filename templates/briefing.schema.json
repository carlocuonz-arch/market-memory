{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Market Memory Briefing",
  "type": "object",
  "required": [
    "schema_version", "date", "briefing_type", "language",
    "data_classification", "market_status", "headline", "market_regime",
    "scorecard", "confidence", "source"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "briefing_type": { "enum": ["europe_daily", "us_daily", "weekend"] },
    "language": { "const": "de" },
    "timezone": { "type": "string", "default": "Europe/Zurich" },
    "data_classification": { "enum": ["verified-live", "shared-context"] },
    "market_status": { "enum": ["normal", "holiday", "low_volume", "closed"] },
    "headline": { "type": "string" },
    "market_regime": { "type": "string" },
    "market_moves": {
      "type": "object",
      "description": "Instrument -> quote. Unknown numbers = null.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": { "type": ["number", "null"] },
          "change_pct": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "scorecard": {
      "type": "object",
      "required": ["europe_tech", "us_tech", "health_rotation", "risk_sentiment", "volatility", "rates", "crypto_liquidity"],
      "additionalProperties": false,
      "patternProperties": {
        "^(europe_tech|us_tech|health_rotation|risk_sentiment|volatility|rates|crypto_liquidity)$": {
          "type": "object",
          "required": ["score", "interpretation"],
          "properties": {
            "score": { "type": ["integer", "null"], "minimum": -2, "maximum": 2 },
            "interpretation": { "type": "string" }
          }
        }
      }
    },
    "top_themes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": { "type": "integer" },
          "theme": { "type": "string" },
          "mechanism": { "type": "string" },
          "beneficiaries": { "type": "array", "items": { "type": "string" } },
          "losers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "portfolio_themes": {
      "type": "object",
      "properties": {
        "etfs": { "type": ["string", "null"] },
        "health_ai": { "type": ["string", "null"] },
        "tech": { "type": ["string", "null"] },
        "crypto": { "type": ["string", "null"] },
        "quality": { "type": ["string", "null"] },
        "cash": { "type": ["string", "null"] }
      }
    },
    "trigger_calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "event", "impact"],
        "properties": {
          "date": { "type": "string" },
          "time_et": { "type": ["string", "null"] },
          "time_zurich": { "type": ["string", "null"] },
          "event": { "type": "string" },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "scenario_hotter": { "type": ["string", "null"] },
          "scenario_cooler": { "type": ["string", "null"] }
        }
      }
    },
    "positioning": {
      "type": "object",
      "properties": {
        "stance": { "type": ["string", "null"] },
        "overweight": { "type": "array", "items": { "type": "string" } },
        "neutral": { "type": "array", "items": { "type": "string" } },
        "underweight": { "type": "array", "items": { "type": "string" } },
        "what_not_to_do": { "type": ["string", "null"] }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["level_pct"],
      "properties": {
        "level_pct": { "type": "integer", "minimum": 0, "maximum": 100 },
        "uncertainty_vectors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "created_by": { "type": "string" },
        "engine": { "type": "string" },
        "data_sources": { "type": "array", "items": { "type": "string" } },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
